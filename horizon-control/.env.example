# Horizon Control local env example. Copy to .env (gitignored). No secrets in git.

HORIZON_BIND=127.0.0.1
HORIZON_PORT=8787
HORIZON_PUBLIC_URL=http://127.0.0.1:8787
HORIZON_DATA_DIR=
HORIZON_SQLITE_PATH=:memory:

HORIZON_OIDC_ISSUER=https://YOUR_TENANT.auth0.com/
HORIZON_OIDC_AUDIENCE=https://horizon-control.tailnet/mcp
HORIZON_OIDC_JWKS_URI=https://YOUR_TENANT.auth0.com/.well-known/jwks.json

HORIZON_STOREFRONT_URL=https://horizonfit.com.ar
HORIZON_WOO_BASE_URL=https://api.horizonfit.com.ar
HORIZON_REPO_PATH=
