# Bind Tailscale IP in production. Default is loopback so the process is never public.
HORIZON_BIND=127.0.0.1
HORIZON_PORT=8787
HORIZON_PUBLIC_URL=http://127.0.0.1:8787

# Auth0 (Authorization Server). horizon-control is Resource Server only.
HORIZON_OIDC_ISSUER=https://YOUR_TENANT.auth0.com/
HORIZON_OIDC_AUDIENCE=https://horizon-control.tailnet/mcp
HORIZON_OIDC_JWKS_URI=https://YOUR_TENANT.auth0.com/.well-known/jwks.json

HORIZON_STOREFRONT_URL=https://horizonfit.com.ar
HORIZON_WOO_BASE_URL=https://api.horizonfit.com.ar
HORIZON_REPO_PATH=/root/horizon-fit
HORIZON_CACHE_DIR=/root/horizon-fit/backend/wordpress/wp-content/uploads/horizon-fit-cache
HORIZON_MERCHANT_DIAGNOSTICS_PATH=/root/horizon-fit/backend/wordpress/wp-content/uploads/horizon-fit-merchant
# Optional allowlisted HTTP fallback for merchant artifacts:
# HORIZON_MERCHANT_DIAGNOSTICS_URL=

# git fetch for ahead/behind is off by default (does not mutate refs).
HORIZON_GIT_FETCH=

HORIZON_SQLITE_PATH=./data/horizon-control.sqlite

# CLI
HORIZON_CONTROL_URL=http://127.0.0.1:8787
HORIZON_CONTROL_TOKEN=
