# Horizon Control local env example. Copy to .env (gitignored). No secrets in git.

HORIZON_BIND=127.0.0.1
HORIZON_PORT=8787
HORIZON_PUBLIC_URL=http://127.0.0.1:8787
HORIZON_DATA_DIR=
HORIZON_SQLITE_PATH=:memory:

HORIZON_OIDC_ISSUER=https://YOUR_TENANT.auth0.com/
# Must match the Auth0 API Identifier / MCP URL in production (see docs/AUTH0.md).
HORIZON_OIDC_AUDIENCE=http://127.0.0.1:8787/mcp
HORIZON_OIDC_JWKS_URI=https://YOUR_TENANT.auth0.com/.well-known/jwks.json

HORIZON_STOREFRONT_URL=https://horizonfit.com.ar
HORIZON_WOO_BASE_URL=https://api.horizonfit.com.ar
HORIZON_REPO_PATH=
HORIZON_CACHE_DIR=
HORIZON_MERCHANT_DIAGNOSTICS_PATH=
HORIZON_GIT_FETCH=0

# Optional Woo REST (dashboard sales). Never commit real keys.
# HORIZON_WOO_KEY=
# HORIZON_WOO_SECRET=
# Public Auth0 SPA client id for /app (not a secret).
# HORIZON_DASHBOARD_CLIENT_ID=

# Optional Google (GSC + GA4). Service account JSON never in git.
# HORIZON_GOOGLE_SA_PATH=
# HORIZON_GOOGLE_SA_JSON=
# HORIZON_GA4_PROPERTY_ID=
# HORIZON_GSC_SITE_URL=https://horizonfit.com.ar/
# HORIZON_COMPETITOR_URLS=
