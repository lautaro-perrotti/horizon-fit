{
  "name": "horizon-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Horizon Fit control plane: OAuth Resource Server + MCP adapter (Phase 2.5 live connectivity, read-only)",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "horizon": "./src/cli.ts"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:live": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "backup": "tsx scripts/backup.ts",
    "smoke": "tsx scripts/smoke.ts",
    "dashboard:dev": "tsx scripts/dashboard-dev.ts",
    "platform:start": "tsx src/platform/main.ts",
    "platform:dev": "tsx scripts/platform-dev.ts",
    "editor:dev": "vite --config editor/vite.config.ts editor",
    "editor:build": "tsc -p editor/tsconfig.json && vite build --config editor/vite.config.ts editor",
    "platform:test:e2e": "playwright test --config playwright.platform.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "0.45.2",
    "hono": "^4.13.13",
    "jose": "^6.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.20.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
