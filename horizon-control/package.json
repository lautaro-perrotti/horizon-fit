{
  "name": "horizon-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Horizon Fit control plane: OAuth Resource Server + MCP adapter (Phase 2.5 live connectivity, read-only)",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "horizon": "./src/cli.ts"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:live": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "0.45.2",
    "hono": "^4.11.4",
    "jose": "^6.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
