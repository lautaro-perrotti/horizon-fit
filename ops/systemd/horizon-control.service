[Unit]
Description=Horizon Fit control plane (Tailscale-only MCP Resource Server)
Documentation=file:/opt/horizon-control-plane/horizon-control/docs/DEPLOY.md
After=network-online.target tailscaled.service
Wants=network-online.target

# FILE ONLY — do not enable or install this unit from the feat/horizon-control branch.
# A human starts CP on the VPS after Tailscale + Auth0 exist. Do not publish /mcp or /v1 on public nginx.

[Service]
Type=simple
User=root
WorkingDirectory=/opt/horizon-control-plane/horizon-control
Environment=NODE_ENV=production
Environment=HORIZON_BIND=127.0.0.1
Environment=HORIZON_PORT=8787
Environment=HORIZON_DATA_DIR=/var/lib/horizon-control
Environment=HORIZON_REPO_PATH=/root/horizon-fit
# Secrets live here. Create with: install -m 0600 ops/systemd/horizon-control.env.example /etc/horizon-control.env
EnvironmentFile=/etc/horizon-control.env
ExecStartPre=/bin/mkdir -p /var/lib/horizon-control
ExecStartPre=/bin/sh -c 'mode=$(stat -c %%a /etc/horizon-control.env); test "$mode" = "600" || test "$mode" = "400"'
ExecStart=/usr/bin/node --import tsx src/index.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
Nice=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=horizon-control
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
