# Horizon Control environment — copy to /etc/horizon-control.env and chmod 0600.
# NEVER commit the real file. Identifiers below are placeholders, not secrets.

NODE_ENV=production

# Loopback or the VPS Tailscale IPv4 (100.x) / IPv6 (fd7a:115c:a1e0::/48). Never 0.0.0.0.
HORIZON_BIND=127.0.0.1
HORIZON_PORT=8787
# Public URL as agents on the tailnet will call it (Tailscale IP or MagicDNS). Not a public DNS name.
HORIZON_PUBLIC_URL=http://127.0.0.1:8787

# SQLite lives outside the git repo.
HORIZON_DATA_DIR=/var/lib/horizon-control
HORIZON_SQLITE_PATH=/var/lib/horizon-control/horizon-control.sqlite

# Auth0 resource server (no client secrets needed on CP — it only validates JWTs).
# Audience MUST equal the MCP URL / Auth0 API Identifier (Cursor checks PRM resource against this).
HORIZON_OIDC_ISSUER=https://YOUR_TENANT.auth0.com/
HORIZON_OIDC_AUDIENCE=http://100.123.37.74:8787/mcp
HORIZON_OIDC_JWKS_URI=https://YOUR_TENANT.auth0.com/.well-known/jwks.json
# Optional: map Auth0 application client_id → claude|cursor|codex|admin for audit labels.
# HORIZON_OIDC_CLIENT_ALIASES=auth0ClientIdClaude:claude,auth0ClientIdCursor:cursor

HORIZON_STOREFRONT_URL=https://horizonfit.com.ar
HORIZON_WOO_BASE_URL=https://api.horizonfit.com.ar
HORIZON_REPO_PATH=/root/horizon-fit
# HORIZON_CACHE_DIR=/root/horizon-fit/backend/wordpress/wp-content/uploads/horizon-fit-cache
# HORIZON_MERCHANT_DIAGNOSTICS_PATH=/root/horizon-fit/backend/wordpress/wp-content/uploads/horizon-fit-merchant
# HORIZON_GIT_FETCH=0
# HORIZON_WOO_KEY=
# HORIZON_WOO_SECRET=
# HORIZON_DASHBOARD_CLIENT_ID=
# HORIZON_GOOGLE_SA_PATH=/etc/horizon-google.json
# HORIZON_GA4_PROPERTY_ID=
# HORIZON_GSC_SITE_URL=https://horizonfit.com.ar/
# HORIZON_COMPETITOR_URLS=
