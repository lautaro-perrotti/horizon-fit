# Los scripts shell DEBEN tener line endings LF, aunque se editen en Windows.
# Si git los convierte a CRLF, fallan en Linux con "bad interpreter".
*.sh text eol=lf
docker/wordpress/entrypoint.sh text eol=lf

# Horizon Control y ops: siempre LF en el repo para que Windows no genere diffs de solo CRLF.
horizon-control/** text=auto eol=lf
ops/** text=auto eol=lf
horizon-control/**/*.png binary
horizon-control/**/*.jpg binary
horizon-control/**/*.woff2 binary
